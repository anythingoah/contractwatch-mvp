# --- Database ---
DATABASE_URL=postgresql://contractwatch:contractwatch@db:5432/contractwatch

# --- Environment ---
# development | production — production enforces COOKIE_SECURE=true and rejects wildcard CORS
ENVIRONMENT=development

# --- Auth ---
# The app refuses to start if this is left unset or as an obviously-insecure
# placeholder. Generate a real one (do NOT commit the generated value):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME_generate_with_python_secrets_token_urlsafe_48
# Set to true once you're serving over HTTPS in production (required when ENVIRONMENT=production)
COOKIE_SECURE=false

# --- CORS: comma-separated list of frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:3000

# --- Optional integrations (features degrade gracefully if unset) ---
OPENAI_API_KEY=
SLACK_WEBHOOK=
EMAIL_API_KEY=
EMAIL_FROM=alerts@contractwatch.dev

# --- Rate limiting on /auth/signup and /auth/login (per IP) ---
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Scheduler ---
# Set to false on EVERY replica if you split the scheduler into its own
# worker process (backend/worker.py) or run more than one API instance —
# otherwise checks fire once per replica. See README "Scheduler" section.
RUN_SCHEDULER_IN_APP=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
